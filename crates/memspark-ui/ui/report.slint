import { ScrollView } from "std-widgets.slint";

component ReportButton inherits Rectangle {
    in property <string> text;
    in property <bool> light-theme: false;
    callback clicked();
    height: 40px;
    width: 176px;
    border-radius: 10px;
    background: root.light-theme ? (touch.pressed ? #cbd8e8 : #dbe6f4) : (touch.pressed ? #1c2634 : #2a3545);
    Text {
        text: root.text;
        color: root.light-theme ? #172033 : #ffffff;
        font-size: 13px;
        font-family: "Microsoft YaHei UI";
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SectionTitle inherits Text {
    in property <string> label;
    in property <bool> light-theme: false;
    text: root.label;
    color: root.light-theme ? #172033 : #f4f7fb;
    font-size: 18px;
    font-weight: 800;
    font-family: "Microsoft YaHei UI";
}

component KeyMetricCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> hint;
    in property <bool> light-theme: false;
    border-radius: 12px;
    background: root.light-theme ? #ffffff : #101926;
    border-width: 1px;
    border-color: root.light-theme ? #bfd1e6 : #22344a;
    height: 132px;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: root.title; color: root.light-theme ? #5d6d80 : #8fa0b5; font-size: 13px; font-weight: 700; font-family: "Microsoft YaHei UI"; }
        Text { text: root.value; color: root.light-theme ? #172033 : #f4f7fb; font-size: 24px; font-weight: 800; font-family: "Microsoft YaHei UI"; overflow: elide; }
        Text { text: root.hint; color: root.light-theme ? #5d6d80 : #8fa0b5; font-size: 12px; font-family: "Microsoft YaHei UI"; wrap: word-wrap; }
    }
}

component InfoPanel inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> light-theme: false;
    border-radius: 12px;
    background: root.light-theme ? #ffffff : #101926;
    border-width: 1px;
    border-color: root.light-theme ? #bfd1e6 : #22344a;
    min-height: 116px;
    VerticalLayout {
        padding: 16px;
        spacing: 9px;
        Text { text: root.title; color: root.light-theme ? #172033 : #f4f7fb; font-size: 16px; font-weight: 800; font-family: "Microsoft YaHei UI"; }
        Text { text: root.text; color: root.light-theme ? #405065 : #cdd6e3; font-size: 13px; font-family: "Microsoft YaHei UI"; wrap: word-wrap; }
    }
}

export component ReportPage inherits Rectangle {
    in property <bool> light-theme: false;
    in property <string> report-text;
    in property <string> before-memory-text;
    in property <string> after-memory-text;
    in property <string> available-increase-text;
    in property <string> scanned-text;
    in property <string> trimmed-text;
    in property <string> skipped-text;
    in property <string> failed-text;
    in property <string> top-trimmed-text;
    in property <string> primary-process-title;
    in property <string> conclusion-text;
    in property <string> report-type-text;
    in property <string> report-mode-text;
    in property <string> report-duration-text;
    in property <string> available-change-detail-text;
    in property <string> system-release-detail-text;
    in property <string> skip-summary-text;
    in property <string> text-title;
    in property <string> text-reload-last-report;
    in property <string> text-before;
    in property <string> text-after;
    in property <string> text-available-increased;
    in property <string> text-processes-scanned;
    in property <string> text-processes-trimmed;
    in property <string> text-processes-skipped;
    in property <string> text-failed;
    in property <string> text-top-trimmed-processes;
    in property <string> text-detailed-report;
    in property <string> text-conclusion-section;
    in property <string> text-core-results;
    in property <string> text-target-hint;
    in property <string> text-working-set-hint;
    in property <string> text-before-after;
    in property <string> text-change-note;
    in property <string> text-process-table-header;
    in property <string> text-skip-summary-section;
    in property <string> text-skip-table-header;
    callback reload();

    background: root.light-theme ? #f5f8fc : #0f141d;
    ScrollView {
        VerticalLayout {
            width: root.width;
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 24px;
            padding-bottom: 32px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 16px;
                Text {
                    text: root.text-title;
                    color: root.light-theme ? #172033 : #f4f7fb;
                    font-size: 28px;
                    font-weight: 700;
                    font-family: "Microsoft YaHei UI";
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    alignment: end;
                    ReportButton { light-theme: root.light-theme; text: root.text-reload-last-report; clicked => { root.reload(); } }
                }
            }

            Rectangle {
                border-radius: 14px;
                background: root.light-theme ? #e8f1ff : #152033;
                border-width: 1px;
                border-color: root.light-theme ? #8ebcf4 : #2c4b73;
                min-height: 128px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: root.text-conclusion-section; color: root.light-theme ? #172033 : #f4f7fb; font-size: 20px; font-weight: 800; font-family: "Microsoft YaHei UI"; }
                    Text { text: root.conclusion-text; color: root.light-theme ? #304057 : #d8e6f6; font-size: 15px; font-family: "Microsoft YaHei UI"; wrap: word-wrap; }
                    Text { text: root.report-type-text + " / " + root.report-mode-text + " / " + root.report-duration-text; color: root.light-theme ? #1767c7 : #8fc7ff; font-size: 12px; font-family: "Microsoft YaHei UI"; wrap: word-wrap; }
                }
            }

            Rectangle {
                border-radius: 12px;
                background: root.light-theme ? #f7faff : #151c27;
                border-width: 1px;
                border-color: root.light-theme ? #bfd1e6 : #22344a;
                height: 362px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    SectionTitle { light-theme: root.light-theme; label: root.text-core-results; }
                    HorizontalLayout {
                        spacing: 12px;
                        KeyMetricCard { width: (root.width - 108px) / 2; light-theme: root.light-theme; title: root.text-available-increased; value: root.available-increase-text; hint: root.available-change-detail-text; }
                        KeyMetricCard { width: (root.width - 108px) / 2; light-theme: root.light-theme; title: root.text-processes-trimmed; value: root.trimmed-text; hint: root.text-target-hint; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        KeyMetricCard { width: (root.width - 108px) / 2; light-theme: root.light-theme; title: root.text-processes-skipped; value: root.skipped-text; hint: root.text-working-set-hint; }
                        KeyMetricCard { width: (root.width - 108px) / 2; light-theme: root.light-theme; title: root.text-failed; value: root.failed-text; hint: root.system-release-detail-text; }
                    }
                }
            }

            Rectangle {
                border-radius: 12px;
                background: root.light-theme ? #f7faff : #151c27;
                border-width: 1px;
                border-color: root.light-theme ? #bfd1e6 : #22344a;
                height: 344px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    SectionTitle { light-theme: root.light-theme; label: root.text-before-after; }
                    HorizontalLayout {
                        spacing: 12px;
                        InfoPanel { width: (root.width - 108px) / 2; light-theme: root.light-theme; title: root.text-before; text: root.before-memory-text; }
                        InfoPanel { width: (root.width - 108px) / 2; light-theme: root.light-theme; title: root.text-after; text: root.after-memory-text; }
                    }
                    Rectangle {
                        border-radius: 12px;
                        background: root.light-theme ? #ffffff : #101926;
                        border-width: 1px;
                        border-color: root.light-theme ? #bfd1e6 : #22344a;
                        height: 104px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text { text: root.text-change-note; color: root.light-theme ? #172033 : #f4f7fb; font-size: 16px; font-weight: 800; font-family: "Microsoft YaHei UI"; }
                            Text { text: root.available-change-detail-text; color: root.light-theme ? #405065 : #cdd6e3; font-size: 13px; font-family: "Microsoft YaHei UI"; wrap: word-wrap; }
                        }
                    }
                }
            }

            Rectangle {
                border-radius: 12px;
                background: root.light-theme ? #f7faff : #151c27;
                border-width: 1px;
                border-color: root.light-theme ? #bfd1e6 : #22344a;
                height: 292px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    SectionTitle { light-theme: root.light-theme; label: root.primary-process-title; }
                    Rectangle {
                        border-radius: 12px;
                        background: root.light-theme ? #ffffff : #101926;
                        border-width: 1px;
                        border-color: root.light-theme ? #bfd1e6 : #22344a;
                        height: 216px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.text-process-table-header; color: root.light-theme ? #172033 : #f4f7fb; font-size: 15px; font-weight: 800; font-family: "Microsoft YaHei UI"; wrap: word-wrap; }
                            ScrollView {
                                VerticalLayout {
                                    padding: 0px;
                                    Text { text: root.top-trimmed-text; color: root.light-theme ? #405065 : #cdd6e3; font-size: 13px; font-family: "Microsoft YaHei UI"; horizontal-alignment: left; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                border-radius: 12px;
                background: root.light-theme ? #f7faff : #151c27;
                border-width: 1px;
                border-color: root.light-theme ? #bfd1e6 : #22344a;
                height: 252px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    SectionTitle { light-theme: root.light-theme; label: root.text-skip-summary-section; }
                    Rectangle {
                        border-radius: 12px;
                        background: root.light-theme ? #ffffff : #101926;
                        border-width: 1px;
                        border-color: root.light-theme ? #bfd1e6 : #22344a;
                        height: 176px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.text-skip-table-header; color: root.light-theme ? #172033 : #f4f7fb; font-size: 15px; font-weight: 800; font-family: "Microsoft YaHei UI"; wrap: word-wrap; }
                            ScrollView {
                                VerticalLayout {
                                    padding: 0px;
                                    Text { text: root.skip-summary-text; color: root.light-theme ? #405065 : #cdd6e3; font-size: 13px; font-family: "Microsoft YaHei UI"; horizontal-alignment: left; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                border-radius: 12px;
                background: root.light-theme ? #f7faff : #151c27;
                border-width: 1px;
                border-color: root.light-theme ? #bfd1e6 : #22344a;
                height: 334px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    SectionTitle { light-theme: root.light-theme; label: root.text-detailed-report; }
                    Rectangle {
                        border-radius: 10px;
                        background: root.light-theme ? #ffffff : #0d1724;
                        height: 260px;
                        ScrollView {
                            VerticalLayout {
                                padding: 14px;
                                Text { text: root.report-text; color: root.light-theme ? #405065 : #cdd6e3; font-size: 13px; font-family: "Microsoft YaHei UI"; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }
}
